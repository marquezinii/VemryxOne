<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(VemryxOneWindowsTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Testhost precisa carregar PresentationCore para validar o sanitizador WPF. -->
    <NoWarn>$(NoWarn);NETSDK1086</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vemryx.One.UpdateRuntime\Vemryx.One.UpdateRuntime.csproj" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="coverlet.MTP">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Vemryx.One.App/Vemryx.One.App.csproj" />
    <ProjectReference Include="../../src/Vemryx.One.Contracts/Vemryx.One.Contracts.csproj" />
    <ProjectReference Include="../../src/Vemryx.One.Core/Vemryx.One.Core.csproj" />
    <ProjectReference Include="../../src/Vemryx.One.Windows/Vemryx.One.Windows.csproj" />
    <ProjectReference Include="../../src/Vemryx.One.Updater/Vemryx.One.Updater.csproj" />
  </ItemGroup>
</Project>
