<UserControl x:Class="Ralven.App.Views.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScrollViewer}">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
            <StackPanel>
                <TextBlock Text="{Binding [Games.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding [Games.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource FiveMGameCardSurface}"
                Width="360"
                Height="570"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"
                AutomationProperties.Name="{Binding [Games.FiveM.Title], Source={StaticResource LocalizedStrings}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="290" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource FiveMGameTileArtworkBrush}"
                        CornerRadius="18,18,0,0"
                        ClipToBounds="True">
                    <Image Source="/Ralven;component/Assets/FiveM.png"
                           Stretch="Uniform"
                           Margin="36"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Row="1" Margin="24,20,24,0">
                    <TextBlock Text="{Binding [Games.FiveM.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DisplayText}" />
                    <Border Background="{DynamicResource FiveMGameTileLabelBrush}"
                            BorderBrush="{DynamicResource FiveMGameTileBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12,8"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0">
                        <TextBlock Text="{Binding [Games.FiveM.Edition], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" />
                    </Border>
                    <TextBlock Text="{Binding [Games.FiveM.Description], Source={StaticResource LocalizedStrings}}"
                               Style="{StaticResource SecondaryText}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Row="2"
                        Content="{Binding [Games.FiveM.Action], Source={StaticResource LocalizedStrings}}"
                        ToolTip="{Binding [Games.FiveM.ActionTooltip], Source={StaticResource LocalizedStrings}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="24,22,24,24"
                        Click="OpenFiveM_Click" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
