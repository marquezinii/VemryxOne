<UserControl x:Class="Ralven.App.Views.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
            <StackPanel>
                <TextBlock Text="{Binding [Games.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding [Games.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource FeatureCardSurface}" Width="520" HorizontalAlignment="Left" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FeatureIconSurface}">
                        <Path Style="{StaticResource Icon20}" Data="{StaticResource IconGame}" Stroke="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Games.FiveM.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                        <TextBlock Text="{Binding [Games.FiveM.Edition], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding [Games.FiveM.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,0" />
                <Button Grid.Row="2"
                        Content="{Binding [Games.FiveM.Action], Source={StaticResource LocalizedStrings}}"
                        ToolTip="{Binding [Games.FiveM.ActionTooltip], Source={StaticResource LocalizedStrings}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,22,0,0"
                        Click="OpenFiveM_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
