<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tokens semânticos de cor — tema claro. Mesmas chaves de
        Colors.Dark.xaml; só o valor muda.

        DIREÇÃO VEMRYX ONE — tema claro
        =================================
        Neutros frios preservam a mesma hierarquia do tema escuro. Índigo
        carrega interação; ciano identifica a marca.
    -->

    <Color x:Key="CanvasBaseColor">#F5F7FB</Color>
    <Color x:Key="CanvasSunkenColor">#EEF2F8</Color>
    <Color x:Key="Surface1Color">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#EEF2F8</Color>
    <Color x:Key="Surface3Color">#E7ECF5</Color>
    <Color x:Key="SurfaceRailColor">#F0F3F8</Color>
    <Color x:Key="SurfaceAccentWashColor">#EEF1FF</Color>

    <SolidColorBrush x:Key="CanvasBaseBrush" Color="{StaticResource CanvasBaseColor}" />
    <SolidColorBrush x:Key="CanvasSunkenBrush" Color="{StaticResource CanvasSunkenColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="SurfaceRailBrush" Color="{StaticResource SurfaceRailColor}" />
    <SolidColorBrush x:Key="SurfaceAccentWashBrush" Color="{StaticResource SurfaceAccentWashColor}" />

    <!-- Luz ambiente sutil da marca, sem reduzir o contraste do conteúdo. -->
    <RadialGradientBrush x:Key="AmbientLightBrush"
                         GradientOrigin="0.10,1.04"
                         Center="0.10,1.04"
                         RadiusX="1.00"
                         RadiusY="1.20">
        <GradientStop Color="#285B7CFF" Offset="0" />
        <GradientStop Color="#1627C8FF" Offset="0.30" />
        <GradientStop Color="#085B7CFF" Offset="0.58" />
        <GradientStop Color="#005B7CFF" Offset="1" />
    </RadialGradientBrush>

    <!-- Preenchimento dos painéis entre as superfícies oficiais claras. -->
    <LinearGradientBrush x:Key="PanelFillBrush" StartPoint="0.85,0" EndPoint="0.15,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFD" Offset="0.55" />
        <GradientStop Color="#F2F5FA" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#D8DEEA" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#C4CCDB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#9BA7BA" />

    <LinearGradientBrush x:Key="EdgeLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.16" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E8F1" />
    <SolidColorBrush x:Key="TickMarkBrush" Color="#B9C3D3" />

    <!-- Queda de luz vertical dentro de uma região grande de conteúdo. -->
    <LinearGradientBrush x:Key="SheetGridBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#0A4057D6" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#11141B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6473" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#626D7E" />
    <SolidColorBrush x:Key="AppTextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4057D6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3147BE" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="#3449C2" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#283A9E" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#E7EBFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F2F4FF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4057D6" Offset="0" />
        <GradientStop Color="#00769F" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrandInkBrush" Color="#00769F" />
    <SolidColorBrush x:Key="GamingAccentBrush" Color="#FF8A1F" />

    <SolidColorBrush x:Key="SuccessBaseBrush" Color="#08784F" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E8F7F0" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#AEDFC9" />

    <SolidColorBrush x:Key="WarningBaseBrush" Color="#865500" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF5DE" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E8CF91" />

    <SolidColorBrush x:Key="DangerBaseBrush" Color="#C4322B" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0BBB7" />

    <SolidColorBrush x:Key="InfoBaseBrush" Color="#00769F" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E6F6FB" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#ADD9E7" />

    <SolidColorBrush x:Key="RevertBaseBrush" Color="#6447C6" />

    <SolidColorBrush x:Key="NeutralBaseBrush" Color="#626D7E" />

    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleTrackOffHoverBrush" Color="#E3E8F1" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#667286" />
    <SolidColorBrush x:Key="ToggleThumbOnBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B9C3D3" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8E9BAF" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#4057D6" />

    <DropShadowEffect x:Key="Elevation1Shadow" Color="#172033" Opacity="0.08" BlurRadius="12" ShadowDepth="2" Direction="270" />
    <DropShadowEffect x:Key="Elevation2Shadow" Color="#172033" Opacity="0.13" BlurRadius="24" ShadowDepth="5" Direction="270" />
    <DropShadowEffect x:Key="Elevation3Shadow" Color="#172033" Opacity="0.20" BlurRadius="46" ShadowDepth="14" Direction="270" />
</ResourceDictionary>
