<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(VemryxOneWindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Vemryx.One.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/VemryxOne.ico</ApplicationIcon>
    <!--
      ApplicationHighDpiMode (a alternativa sugerida pelo aviso WFO0003) não
      tem efeito aqui: ela só é aplicada pelo Program.Main gerado pelo
      designer do WinForms (ApplicationConfiguration.Initialize()), e este
      projeto usa WinForms só para a bandeja do sistema — quem inicia é o
      App.xaml do WPF. A leitura efetiva de DPI da janela principal vem do
      HwndSource do WPF, que só respeita o dpiAwareness declarado no
      manifesto abaixo. Suprimido intencionalmente, não ignorado por engano.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>FiveMCleaner</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="WPF-UI" />
    <ProjectReference Include="../Vemryx.One.Contracts/Vemryx.One.Contracts.csproj" />
    <ProjectReference Include="../Vemryx.One.Core/Vemryx.One.Core.csproj" />
    <ProjectReference Include="../Vemryx.One.Windows/Vemryx.One.Windows.csproj" />
    <ProjectReference Include="../Vemryx.One.UpdateRuntime/Vemryx.One.UpdateRuntime.csproj" />
    <ProjectReference Include="../Vemryx.One.Broker/Vemryx.One.Broker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/VemryxOne.png" />
    <EmbeddedResource Include="Assets/release-public-key.pem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Config/appsettings.json;Config/appsettings.Development.json;Config/appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Machine-local, git-ignored overlay (see RemoteServicesOptionsLoader) for
      values GitHub's push protection would otherwise reject in a commit, like
      the Google OAuth client secret. The glob matches nothing on a normal
      checkout, so it never fails the build when absent.
    -->
    <Content Include="Config/appsettings.*.local.json" Condition="Exists('Config')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyBroker" AfterTargets="Build">
    <MSBuild
      Projects="../Vemryx.One.Broker/Vemryx.One.Broker.csproj"
      Targets="GetBrokerOutputDirectory"
      BuildInParallel="$(BuildInParallel)"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BrokerOutputDirectory" />
    </MSBuild>
    <Error Condition="'@(_BrokerOutputDirectory)' == ''" Text="Unable to resolve the Vemryx.One.Broker build output." />
    <PropertyGroup>
      <_BrokerOutputDirectoryPath>@(_BrokerOutputDirectory)</_BrokerOutputDirectoryPath>
    </PropertyGroup>
    <ItemGroup>
      <BrokerFiles Include="$(_BrokerOutputDirectoryPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerFiles)" DestinationFiles="@(BrokerFiles->'$(OutDir)broker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
