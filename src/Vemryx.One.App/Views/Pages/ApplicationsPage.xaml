<UserControl x:Class="Vemryx.One.App.Views.Pages.ApplicationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource TitleBlockSurface}">
                <StackPanel>
                    <TextBlock Text="{Binding [Applications.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PageTitleText}" />
                    <Rectangle Style="{StaticResource TitleAccentRule}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding [Applications.Subtitle], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <primitives:UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Top">
                <Border Style="{StaticResource PanelSurface}" Padding="24" Margin="0,0,16,16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Applications.Installed.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Installed.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="{Binding [Applications.Installed.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,24,0,0" Click="OpenInstalledApps_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource PanelSurface}" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Applications.Startup.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Startup.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="{Binding [Applications.Startup.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,24,0,0" Click="OpenStartupApps_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource PanelSurface}" Padding="24" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Applications.StoreUpdates.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.StoreUpdates.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="{Binding [Applications.StoreUpdates.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,24,0,0" Click="OpenStoreUpdates_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource PanelSurface}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [Applications.Defaults.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                            <TextBlock Text="{Binding [Applications.Defaults.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1" Content="{Binding [Applications.Defaults.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,24,0,0" Click="OpenDefaultApps_Click" />
                    </Grid>
                </Border>
            </primitives:UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
