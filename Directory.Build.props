<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <VemryxOneTargetFramework>net10.0</VemryxOneTargetFramework>
    <VemryxOneWindowsTargetFramework>net10.0-windows10.0.19041.0</VemryxOneWindowsTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Vemryx</Authors>
    <Company>Vemryx</Company>
    <Copyright>Copyright (c) 2026 Vemryx. All rights reserved.</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/marquezinii/FiveMCleaner</RepositoryUrl>
    <Product>Vemryx One</Product>
    <Version>1.5.0</Version>
  </PropertyGroup>
</Project>
